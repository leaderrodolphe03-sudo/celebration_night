# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sécurité & Chiffrement des sessions Admin (HMAC-SHA256)
# 32 caracteres minimum. Generer avec : openssl rand -base64 48
AUTH_SECRET=

# Service d'envoi d'email (optionnel - Resend / SendGrid)
EMAIL_API_KEY=
EMAIL_FROM="Célébration Night <billets@celebrationnight.org>"

# --- PRÉPARATION MIGRATION SUPABASE (ÉTAPE FUTURE) ---
# Supabase PostgreSQL connection string (Direct ou Pooling via Transaction PgBouncer)
DATABASE_URL=postgresql://postgres:[VOTRE-MOT-DE-PASSE]@db.[VOTRE-PROJET-REF].supabase.co:5432/postgres
# Clés API du projet Supabase
# Format : https://<ref-du-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
