# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sécurité & Chiffrement des sessions Admin (HMAC-SHA256 - Définir une clé secrète aléatoire de 64 caractères hex)
AUTH_SECRET=definir_une_cle_secrete_aleatoire_de_64_caracteres_hexadécimaux

# --- CONFIGURATION SUPABASE ---
# URL de votre projet Supabase (ex: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé API publique Anon (commençant par ey...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète Service Role (indispensable pour l'insertion sécurisée côté serveur)
SUPABASE_SERVICE_ROLE_KEY=
