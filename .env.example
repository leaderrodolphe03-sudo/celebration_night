# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sécurité & Chiffrement des sessions Admin (HMAC-SHA256)
AUTH_SECRET=celebration-night-hagiazo-super-secret-key-2026-phase1-4

# Code d'accès secret pour le portail Admin (par défaut : 2026)
ADMIN_ACCESS_CODE=2026

# --- CONFIGURATION SUPABASE ---
# URL de votre projet Supabase (ex: https://abcdefghijkl.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé API publique Anon (commençant par ey...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé secrète Service Role (indispensable pour l'insertion sécurisée côté serveur)
SUPABASE_SERVICE_ROLE_KEY=
