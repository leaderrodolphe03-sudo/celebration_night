// Schema Prisma de production pour PostgreSQL (Supabase, Neon, AWS RDS, etc.)
// A utiliser en production en renommant ce fichier ou en configurant prisma avec ce schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketType {
  STANDARD
  VIP
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
}

enum AdminRole {
  ADMIN
  STAFF
}

model Participant {
  id              String      @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String
  country         String
  city            String
  numberOfGuests  Int         @default(1)
  ticketType      TicketType  @default(STANDARD)
  source          String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tickets Ticket[]

  @@index([email])
}

model Ticket {
  id            String       @id @default(cuid())
  ticketNumber  String       @unique // ex: CN-2026-000001
  qrToken       String       @unique // Token cryptographique sécurisé (sans PII)
  ticketType    TicketType   @default(STANDARD)
  status        TicketStatus @default(VALID)
  scannedAt     DateTime?
  scannedBy     String?

  participantId String
  participant   Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([qrToken])
  @@index([ticketNumber])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  salt         String
  role         AdminRole @default(STAFF)
  createdAt    DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}
